rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open to any signed-in Google account (deliberate: shared access without an allowlist).
    // Anyone who has the app URL and signs in with Google can read and write the plan.
    match /weddings/{planId} {
      allow read, write: if request.auth != null;
    }
  }
}
